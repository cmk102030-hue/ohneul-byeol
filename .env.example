# ── AI (필수) ──────────────────────────────────────────────
# 키 미설정 시 운세·궁합은 mock(고정문장) 응답. 실 서비스 전 반드시 등록.
# ⚠️ P0: Anthropic 콘솔에서 월 spend limit 하드캡을 함께 설정할 것.
ANTHROPIC_API_KEY=

# ── 운영 보호 (선택, 권장) ─────────────────────────────────
# 허용 origin (콤마 구분). 운영에서 미설정 시 같은 host referer만 통과(느슨).
# 예: ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=

# rate-limit·LLM 캐시 분산 backend (Upstash Redis REST).
# 미설정 시 in-memory fallback(serverless 인스턴스별·콜드스타트 리셋 → best-effort).
# 운영 트래픽에선 설정 권장. https://upstash.com 무료 tier.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
